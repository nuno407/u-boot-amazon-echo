@@ -185,6 +193,7 @@ void do_bad_error(struct pt_regs *pt_regs)
 	efi_restore_gd();
 	printf("Bad mode in \"Error\" handler, esr 0x%08lx\n", pt_regs->esr);
 	show_regs(pt_regs);
+	board_exception_hook(pt_regs);
 	show_efi_loaded_images(pt_regs);
 	panic("Resetting CPU ...\n");
 }
@@ -202,6 +211,7 @@ void do_sync(struct pt_regs *pt_regs)
 	dump_far(pt_regs->esr);
 	printf("\n");
 	show_regs(pt_regs);
+	board_exception_hook(pt_regs);
 	show_efi_loaded_images(pt_regs);
 	panic("Resetting CPU ...\n");
 }
@@ -214,6 +224,7 @@ void do_irq(struct pt_regs *pt_regs)
 	efi_restore_gd();
 	printf("\"Irq\" handler, esr 0x%08lx\n", pt_regs->esr);
 	show_regs(pt_regs);
+	board_exception_hook(pt_regs);
 	show_efi_loaded_images(pt_regs);
 	panic("Resetting CPU ...\n");
