diff --git a/lib/panic.c b/lib/panic.c
index 0f578b5b..92d36078 100644
--- a/lib/panic.c
+++ b/lib/panic.c
@@ -15,9 +15,15 @@
 #endif
 #include <linux/delay.h>
 #include <stdio.h>
+#include <vsprintf.h>
 
 static void panic_finish(void) __attribute__ ((noreturn));
 
+/* A board may record the panic (e.g. somewhere that survives the reset) before it happens. */
+__weak void board_panic_hook(const char *msg)
+{
+}
+
 static void panic_finish(void)
 {
 	putc('\n');
@@ -35,6 +41,7 @@ static void panic_finish(void)
 void panic_str(const char *str)
 {
 	puts(str);
+	board_panic_hook(str);
 	panic_finish();
 }
 
@@ -42,9 +49,17 @@ void panic(const char *fmt, ...)
 {
 #if CONFIG_IS_ENABLED(PRINTF)
 	va_list args;
+	char msg[64];
+
 	va_start(args, fmt);
 	vprintf(fmt, args);
 	va_end(args);
+	va_start(args, fmt);
+	vsnprintf(msg, sizeof(msg), fmt, args);
+	va_end(args);
+	board_panic_hook(msg);
+#else
+	board_panic_hook(fmt);
 #endif
 	panic_finish();
 }
