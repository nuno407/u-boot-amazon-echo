+++ b/arch/arm/lib/interrupts_64.c
@@ -70,6 +70,11 @@ static void dump_far(unsigned long esr)
 	printf(", far 0x%lx", far);
 }
 
+/* A board may record the exception (e.g. somewhere that survives the reset) before the panic. */
+__weak void board_exception_hook(struct pt_regs *regs)
+{
+}
+
 static void dump_instr(struct pt_regs *regs)
 {
 	u32 *addr = (u32 *)(regs->elr & ~3UL);
@@ -149,6 +154,7 @@ void do_bad_sync(struct pt_regs *pt_regs)
 	printf("Bad mode in \"Synchronous Abort\" handler, esr 0x%08lx\n",
 	       pt_regs->esr);
 	show_regs(pt_regs);
+	board_exception_hook(pt_regs);
 	show_efi_loaded_images(pt_regs);
 	panic("Resetting CPU ...\n");
 }
@@ -161,6 +167,7 @@ void do_bad_irq(struct pt_regs *pt_regs)
 	efi_restore_gd();
 	printf("Bad mode in \"Irq\" handler, esr 0x%08lx\n", pt_regs->esr);
 	show_regs(pt_regs);
+	board_exception_hook(pt_regs);
 	show_efi_loaded_images(pt_regs);
 	panic("Resetting CPU ...\n");
 }
@@ -173,6 +180,7 @@ void do_bad_fiq(struct pt_regs *pt_regs)
