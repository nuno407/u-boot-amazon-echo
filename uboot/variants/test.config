# SPDX-License-Identifier: GPL-2.0-or-later
# A test build, for the recovery partition (each Echo board's README.md, "Testing safely"): it clears
# misc's boot-recovery command first, adds CONFIG_AB_TEST_MARKER to the kernel command line, and
# takes the rescue kernel from /rescue.img on the store (the recovery partition holds the test build).
CONFIG_AB_TESTSLOT=y
CONFIG_AB_RESCUE_FILE="/rescue.img"
