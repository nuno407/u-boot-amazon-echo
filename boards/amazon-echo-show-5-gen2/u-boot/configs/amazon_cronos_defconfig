CONFIG_ARM=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_TARGET_MT8183=y
CONFIG_BOARD_AMAZON_CRONOS=y
CONFIG_COUNTER_FREQUENCY=13000000
CONFIG_POSITION_INDEPENDENT=y
CONFIG_INIT_SP_RELATIVE=y
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x80000
CONFIG_TEXT_BASE=0x40200000
CONFIG_SYS_MALLOC_F_LEN=0x10000
CONFIG_SYS_MALLOC_LEN=0x2000000
CONFIG_NR_DRAM_BANKS=1
CONFIG_MTK_MEM_MAP_DDR_SIZE=0x3f000000
CONFIG_DEFAULT_DEVICE_TREE="mt8163-amazon-cronos-uboot"
CONFIG_SYS_LOAD_ADDR=0x50000000
# CONFIG_PSCI_RESET is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_ANDROID_BOOT_IMAGE is not set
# CONFIG_ARCH_FIXUP_FDT_MEMORY is not set
# CONFIG_BOOTSTD_DEFAULTS is not set
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="abboot"
CONFIG_SYS_CBSIZE=1024
CONFIG_SYS_PBSIZE=1100
# CONFIG_DISPLAY_BOARDINFO is not set
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BOOTI=y
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_FDT=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_WDT=y
CONFIG_PARTITION_UUIDS=y
CONFIG_EFI_PARTITION=y
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_SOURCE_FILE="cronos"
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
CONFIG_CLK=y
# CONFIG_INPUT is not set
# CONFIG_MMC_QUIRKS is not set
CONFIG_MMC_MTK=y
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_POWER is not set
CONFIG_BAUDRATE=921600
CONFIG_DM_SERIAL=y
CONFIG_MTK_SERIAL=y
# CONFIG_USB is not set
CONFIG_VIDEO=y
# CONFIG_VIDEO_LOGO is not set
# CONFIG_VIDEO_BPP8 is not set
# CONFIG_VIDEO_BPP16 is not set
CONFIG_VIDEO_BPP32=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_CONSOLE_ROTATION=y
CONFIG_VIDEO_FONT_8X16=y
CONFIG_VIDEO_FONT_16X32=y
CONFIG_VIDEO_SIMPLE=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x100000
CONFIG_WDT=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=31000
CONFIG_WDT_MTK=y
CONFIG_WDT_MTK_LONG_LENGTH=y
# CONFIG_RANDOM_UUID is not set
# CONFIG_REGEX is not set
CONFIG_ABBOOT=y
CONFIG_AB_MENU=y
CONFIG_AB_MISC_PART="MISC"
CONFIG_AB_SELF_MARKER="abboot-echo-show-5-gen2-self"
CONFIG_AB_SLOT_ARGS="watchdog.open_timeout=120 mtk_wdt.nowayout=1 panic=5"
CONFIG_AB_STAY_HINT="Hold Volume Down and plug in USB for fastboot"
CONFIG_AB_CRUMBS=y
# Volume Up GPIO 36, Volume Down GPIO 37: GPIO_DIN3 0x10005520 (0x10005000 + 0x500 + (pin / 16) *
# 0x10), bits 4 and 5, active low. Mute (GPIO 47) never changes before Linux: not read.
CONFIG_AB_KEY_UP_REG=0x10005520
CONFIG_AB_KEY_UP_BIT=4
CONFIG_AB_KEY_DOWN_REG=0x10005520
CONFIG_AB_KEY_DOWN_BIT=5
# LK's display stalled on this boot (about 1 in 16): nothing drawn would be seen.
CONFIG_AB_MENU_HIDE_IF_PRIOR_ARG="fps=6000"
# MT8163's PSCI 0.1 has no SYSTEM_RESET.
CONFIG_AB_RESET_WDT=y
