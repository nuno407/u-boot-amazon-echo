# Amazon Echo Show 5 2nd gen (cronos, MT8163). U-Boot here is not BL33: the device's bootloader
# (LK, after amonet's microloader and payload, unlocked with kaeru) starts it from an Android boot
# image in place of the kernel, at EL2 with the MMU off and LK's device tree in x0. There is no MT8163 target in U-Boot;
# the board sits on TARGET_MT8183, whose SoC code is only dram_init from the device tree and a PSCI
# reset this board never uses (MT8163's PSCI 0.1 has no SYSTEM_RESET: the watchdog resets,
# CONFIG_AB_RESET_WDT). The board is configuration only: this file, configs/amazon_cronos_defconfig,
# arch/arm/dts/mt8163-amazon-cronos-uboot.dts and cronos.env. The boot itself is abboot's
# (u-boot-amazon-echo: abboot/, SPEC.md); boards/amazon-echo-show-5-gen2/ in that repository has
# the board's README and PROVENANCE.

config BOARD_AMAZON_CRONOS
	bool "Amazon Echo Show 5 2nd gen (cronos, MT8163), started by LK"
	depends on TARGET_MT8183
	select LINUX_KERNEL_IMAGE_HEADER
	select SAVE_PREV_BL_FDT_ADDR
	select ABBOOT
	select AB_BOARD_INIT
	help
	  U-Boot for the Echo Show 5 2nd gen, packed as the kernel of an amonet boot image (the
	  microloader in the first 1 KB, the real header at 0x400) that the device's bootloader
	  starts.

if BOARD_AMAZON_CRONOS

config SYS_VENDOR
	default "amazon"

config SYS_BOARD
	default "cronos"

config SYS_CONFIG_NAME
	default "amazon_cronos"

config LNX_KRNL_IMG_TEXT_OFFSET_BASE
	default TEXT_BASE

endif
